# Secrets uniquement dans les variables d'environnement Netlify, jamais dans le navigateur.
# Moteurs IA côté serveur, ordre de secours automatique.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=DeepSeek-V3.1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TWELVEDATA_API_KEY=
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_NOTIFY_SECRET=

# La migration V2.2.9 doit être appliquée avant de déployer le contrôle de session unique.
# Facultatif : données macroéconomiques historiques FRED (DXY pondéré, rendements, taux Fed, CPI, chômage).
FRED_API_KEY=
# DXY distinct de l'indice large du dollar FRED; calendrier économique structuré

# Worker permanent de cotations (configurer ces secrets dans l’hébergeur du worker, pas dans le navigateur).
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY et TWELVEDATA_API_KEY sont réutilisés par le worker.
