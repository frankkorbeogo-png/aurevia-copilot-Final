# Secrets uniquement dans les variables d'environnement Netlify, jamais dans le navigateur.
# Fournisseurs IA serveur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Modèle gratuit fixé dans le code : GLM-4.7-Flash (aucun override de modèle payant).
ZAI_API_KEY=

# Données de marché et macro.
TWELVEDATA_API_KEY=
FRED_API_KEY=

# Authentification et données AUREVIA.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notifications Telegram et appels internes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_NOTIFY_SECRET=

# Tous ces secrets restent côté serveur. Les utilisateurs AUREVIA ne saisissent aucune clé API.
# Appliquer les migrations dans l'ordre, d'abord en staging, puis en production après autorisation.
# Le worker workers/market-quote-stream.mjs est optionnel; s'il est activé, il réutilise
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY et TWELVEDATA_API_KEY côté serveur.
